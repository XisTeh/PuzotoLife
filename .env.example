# Copie para .env. Nunca envie este arquivo preenchido ao GitHub.
NODE_ENV=development
HOST=127.0.0.1
PORT=3210
APP_ORIGIN=http://localhost:5174
# Sem estas 3 variáveis, somente o modo local no loopback fica disponível.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# UUID do seu usuário (Authentication > Users). Não use o e-mail como autorização.
SUPABASE_OWNER_ID=
# Segredo aleatório com no mínimo 32 caracteres para assinar a sessão HttpOnly.
# Use um valor diferente em cada ambiente e nunca use uma variável VITE_*.
SESSION_SECRET=
# Chave secreta do projeto para operar apenas o bucket privado no backend.
# Nunca use em VITE_* nem envie ao navegador.
SUPABASE_SECRET_KEY=
# Use somente no processo privado de migração (não no Vite).
SUPABASE_DB_URL=
# Troque para postgres somente depois de migrar e validar os dados.
PUZOTO_DATABASE=sqlite
# Conexão com usuário puzoto_runtime. Nunca use o administrador no servidor.
SUPABASE_RUNTIME_DB_URL=
# Opcional: certificado CA do painel Supabase, quando exigido pela conexão.
SUPABASE_DB_CA_FILE=
# Na hospedagem, use o conteúdo PEM do mesmo certificado como segredo multilinha.
SUPABASE_DB_CA_CERT=
# Caminho opcional do banco local; testes sempre usam uma pasta temporária.
PUZOTO_LIFE_DB_PATH=
